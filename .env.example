# ── Server ─────────────────────────────────────────────────────────────────
PORT=8799
HOST=127.0.0.1
# Comma-separated normalized underlyings traded on BOTH venues.
# ZEC is the only other overlap (Derive lists 7 ZEC expiries; verified
# 2026-09-28). PAXG/JUP/NVDAX exist only on Olive — nothing to arb.
UNDERLYINGS=SOL,BTC,ETH,ZEC
# Cycle target. NOTE: a full-chain cycle takes ~18-35s (Derive rate limiter
# serializes the fetches) and the busy-guard prevents overlap, so the
# effective cadence is max(POLL_INTERVAL_MS, cycle duration).
POLL_INTERVAL_MS=15000

# Additional listed venues polled alongside Derive + Olive (comma list).
# Available: coincall, hypercall, callput. Bybit/Binance are deferred (they geo-block US hosts).
VENUES=coincall,hypercall,callput
COINCALL_BASE_URL=https://api.coincall.com
HYPERCALL_BASE_URL=https://api.hypercall.xyz
# ~3.5 MB for every asset; read at most once a minute (~5 GB/day).
CALLPUT_FEED_URL=https://app-data-base.s3.ap-southeast-1.amazonaws.com/market-data.json

# ── Derive ──────────────────────────────────────────────────────────────────
DERIVE_BASE_URL=https://api.derive.xyz/v3
DERIVE_LEGACY_URL=https://api.lyra.finance
# v3 REST was observed returning zeroed order books; 'merge' fills bid/ask/OI
# from the legacy host when v3 returns zeros. Options: merge | v3 | legacy
DERIVE_BOOK_SOURCE=merge
# 0 = scan every listed expiry (full-chain profit search; cycle ~20-25s)
DERIVE_MAX_EXPIRIES=0
DERIVE_TAKER_FEE_BPS=3

# ── Olive ───────────────────────────────────────────────────────────────────
OLIVE_API_BASE=https://olive.exchange/api/v1
# Undocumented backend: any non-empty value works today (see DATA_SOURCES.md)
OLIVE_API_KEY=options-arb-analytics
# auto = REST first, on-chain fallback when REST is stale/unreachable
OLIVE_MODE=auto
OLIVE_STALE_MS=60000
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Olive fixed rates — FALLBACK ONLY: live rates stream from the market file's
# per-custody borrowRateCurve at current utilization (their UI's "Fixed Rate
# (L/S)"; verified 2026-09-28 — SOL 15.02%/2.00%, and utilization moves them:
# BTC's USDC custody at 88% util prices puts at a 42% short rate). These pins
# apply only when the market file is unreachable.
OLIVE_RATE_OVERRIDES={"SOL":{"token":0.1507,"usdc":0.02},"BTC":{"token":0.08,"usdc":0.02},"ETH":{"token":0.08,"usdc":0.02},"ZEC":{"token":0.08,"usdc":0.2718}}
OLIVE_TOKEN_RATE_APR=0.1507
OLIVE_USDC_RATE_APR=0.02
# Olive model vol — their EWMA realized vol. FALLBACK ONLY: the live
# market file (state.payload.snapshot.volatility, projected forward by
# their backend) is the primary source; these pins apply when it is
# unreachable. EWMA only updates on ≥15m or ≥5% moves, so drift is slow.
OLIVE_VOL_OVERRIDES={"SOL":0.69,"BTC":0.49,"ETH":0.53,"ZEC":1.01}
# Olive pool liquidity — FALLBACK ONLY: per-custody free balances (calls
# lock the underlying custody, puts the USDC custody) stream live from the
# market file's rawOnChainPoolSnapshot. This scalar AUM-based pin applies
# only when the market file is unreachable and is flagged
# pool_capacity_estimated. Verified 2026-09-27/28 pool pages.
OLIVE_POOL_LIQUIDITY_USD={"SOL":4900}

# ── Olive realtime (socket.io ticker stream) ───────────────────────────────
# One passive connection (like a browser tab): ~1s Stork spot for all feeds.
# Spot priority becomes socket → market file → Pyth → on-chain oracle.
OLIVE_REALTIME=1
OLIVE_REALTIME_URL=wss://olive.exchange/socket.io/?EIO=4&transport=websocket
# Re-price early when spot moves ≥ this % vs the last cycle's print (0 = off;
# 30s cooldown regardless — Derive's rate limiter serializes the extra calls)
OLIVE_REALTIME_SPOT_TRIGGER_PCT=1
# Ticks older than this fall back to the market-file spot
OLIVE_REALTIME_MAX_SPOT_AGE_MS=10000

# ── Matching ────────────────────────────────────────────────────────────────
MATCH_EXPIRY_TOLERANCE_DAYS=1
MATCH_MAX_STRIKE_REL_DIST=0.02
OLIVE_MAX_TENOR_DAYS=365
# Olive strike band in sigmas (docs + live-UI verified 2026-09-29): the venue
# rejects strikes outside the ±1σ expected-move band, so out-of-band rows are
# matched as unmatched/strike_out_of_olive_bounds, not priced. Do not lower.
OLIVE_STRIKE_BOUND_SIGMAS=1

# ── Signals ─────────────────────────────────────────────────────────────────
IV_SPREAD_THRESHOLD_VOLS=3
MIN_BOOK_SIZE=0.1
MAX_REL_BOOK_WIDTH=0.2
NEAR_EXPIRY_DAYS=2
SOLANA_FEE_USDC=0.05
CAPITAL_BORROW_RATE_APR=0.08

# ── Persistence & alerting ──────────────────────────────────────────────────
DATA_DIR=./data
HISTORY_RETENTION_DAYS=30
ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MS=300000
# Only alert on the two-leg-executable direction (buy Olive AMM / sell Derive)
# and skip price-distortion rows; set 0 to alert on everything.
ALERTS_EXECUTABLE_ONLY=1

# ── Alerts ───────────────────────────────────────────────────────────────────
ALERTS_ENABLED=false
# Discord (preferred, one credential): your server → channel settings →
# Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=
# Telegram alternative: 1) @BotFather → /newbot → copy the token.
# 2) Send the bot any message, open https://api.telegram.org/bot<TOKEN>/getUpdates, copy chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Minimum HONEST clip total (USDC, fill-model aware) before alerting.
# 0 = alert on every isOpportunity row (legacy). Suggested: 5.
ALERT_MIN_TOTAL_USDC=5
ALERT_COOLDOWN_MS=300000
ALERTS_EXECUTABLE_ONLY=true
# Fallback transport when Telegram isn't configured (Discord/Slack webhook).
ALERT_WEBHOOK_URL=
